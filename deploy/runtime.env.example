# Copy to the deployment root as runtime.env (ignored by Git).
MINGLI_IMAGE_TAG=local
MINGLI_BIND_ADDRESS=127.0.0.1
MINGLI_PORT=13100
# Set all three URL/bind settings explicitly for a NAS reverse proxy.
NEXT_PUBLIC_SITE_URL=http://localhost:13100
APP_ALLOWED_ORIGINS=http://localhost:13100,http://127.0.0.1:13100
# Empty uses the dedicated Codex CLI configuration's model.
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
# Production retrieval requires the separately provisioned knowledge index.
KNOWLEDGE_REQUIRED=true
KNOWLEDGE_USE_MODE=personal
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
