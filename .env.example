# 复制为 .env.local。本地 AI 后端复用已安装并登录的 Codex CLI。
# 执行 codex login 完成登录，不需要在网页中填写 API Key。

# 留空则使用 CLI 全局默认模型；如账户不支持该模型，在这里指定可用模型。
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_MS=180000

# NAS / 反向代理访问入口；逗号分隔，必须包含协议和实际端口。
# 未配置时仅允许 localhost / 127.0.0.1。
APP_ALLOWED_ORIGINS=
AUTH_REQUIRED=true
# NAS 使用只读检索库；本地不配置时保持原来的纯命盘解读。
# KNOWLEDGE_DB_PATH=/knowledge/index/knowledge.sqlite
# KNOWLEDGE_REQUIRED=true
# personal 包含单独标记的非商业引文；commercial 排除混合授权样本和《天纪》。
# KNOWLEDGE_USE_MODE=personal
# 默认保存在被 Git 忽略的 .codex-local/app-data；容器使用 /data。
# MINGLI_DATA_DIR=

# 通常可自动发现 PATH 中的 CLI；需要时指定原生可执行文件或 codex.js。
# CODEX_CLI_PATH=D:\Promgram Files\Codex\codex.exe

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
